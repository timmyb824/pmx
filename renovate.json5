{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "pre-commit"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks",
      "automerge": true
    }
  ]
}
